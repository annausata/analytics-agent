# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# PostgreSQL connection string used by the Streamlit app and the agent.
# The app connects directly (MCP is only used during development).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Model used for SQL generation and for the final explanation.
# The free tier allows 20 requests per day PER MODEL, and one question costs 2
# requests (SQL + explanation). If you hit `429 RESOURCE_EXHAUSTED`, switch to
# another model below — each has its own separate daily quota.
# Known good: gemini-3-flash-preview (fast), gemini-3.7-flash, gemini-3.8-flash,
#             gemini-3.5-flash, gemini-2.5-pro
# Run `python -c "import agent; [print(m.name) for m in agent._client().models.list()]"`
# to see everything your key can use.
GEMINI_MODEL=gemini-3-flash-preview
